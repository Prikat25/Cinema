# Local development configuration
# For Cloud Run, prefer service-account authentication with Vertex AI and
# Secret Manager for ClickHouse credentials. Never commit real secrets.

# Google / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# If using Gemini API directly instead of Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-api-key-here

# Model configuration
DEFAULT_MODEL=gemini-2.5-flash
SUPERVISOR_MODEL=gemini-2.5-flash
PLANNER_MODEL=gemini-2.5-flash
TAKE_ANALYZER_MODEL=gemini-2.5-flash
EDITOR_MODEL=gemini-2.5-flash

# ClickHouse HTTP connection
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_SECURE=true

# ClickHouse MCP
CLICKHOUSE_MCP_URL=https://mcp.clickhouse.cloud/mcp

# Optional runtime settings
APP_NAME=cine-supervisor
ALLOW_ORIGINS=*
